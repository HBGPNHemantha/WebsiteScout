# Server Port
PORT=5000

# MongoDB Connection String (Leave blank to use embedded memory DB during local development)
MONGODB_URI=mongodb://localhost:27017/websitescout

# Google Maps API Keys
# Server key: used for Places Text Search & Place Details (Enable Places API in Google Cloud Console)
GOOGLE_MAPS_SERVER_API_KEY=your_google_maps_server_api_key_here

# Browser key: domain-restricted key for rendering the map on the frontend
GOOGLE_MAPS_BROWSER_API_KEY=your_google_maps_browser_api_key_here

# JWT Authentication Secret
JWT_SECRET=websitescout_jwt_super_secret_key_2026

# Fallback to realistic mock data if API key is not supplied
USE_MOCK_FALLBACK=true
